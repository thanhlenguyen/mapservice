    {
      "id": "poi-label",
      "type": "symbol",
      "source": "pois",
      "source-layer": "pois_spl",
      "minzoom": 17,
      "layout": {
        "icon-image": ["get", "maki"],
        "icon-size": 1,
        "icon-allow-overlap": true,
        "text-field": ["get", "name"],
        "text-font": ["Open Sans Regular"],
        "text-anchor": "top",
        "text-offset": [0, 0.6],
        "visibility": "visible",
        "text-size": 10
      },
      "paint": {
        "text-color": "#a1a09f",
        "text-halo-color": "#a1a09f",
        "text-halo-width": 0,
        "icon-color": "#78909c"
      }
    }
