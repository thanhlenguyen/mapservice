{
  "options": {
    "paths": {
      "root": "/data",
      "styles": "styles",
      "fonts": "fonts",
      "sprites": "sprites",
      "mbtiles": "mbtiles",
      "pmtiles": "pmtiles"
    },
    "domains": [
      "localhost:8080",
      "127.0.0.1:8080"
    ],
    "formatOptions": {
      "jpeg": {
        "quality": 80
      },
      "webp": {
        "quality": 90
      }
    },
    "maxScaleFactor": 3,
    "maxSize": 2048,
    "pbfAlias": "pbf",
    "serveAllFonts": true,
    "serveAllStyles": false,
    "serveStaticMaps": true,
    "allowRemoteMarkerIcons": true,
    "allowInlineMarkerImages": true,
    "staticAttributionText": "© OpenMapTiles  © OpenStreetMaps",
    "tileMargin": 0
  },
  
  "styles": {
    "def-style": {
      "style": "style.json",
      "tilejson": {
            "type": "overlay",
            "bounds": [-180, -85.0511, 180, 85.0511]
      }
    },
    "sat-style": {
      "style": "style_sat.json",
      "tilejson": {
            "type": "overlay",
            "bounds": [-180, -85.0511, 180, 85.0511]
      }
    },
    "3d-style": {
      "style": "style_3d.json",
      "tilejson": {
            "type": "overlay",
            "bounds": [-180, -85.0511, 180, 85.0511]
      }
    },
    "bdf-style": {
      "style": "style_bdf.json",
      "tilejson": {
            "type": "overlay",
            "bounds": [-180, -85.0511, 180, 85.0511]
      }
    },
    
    "def-style_dm": {
      "style": "style_dm.json",
      "tilejson": {
            "type": "overlay",
            "bounds": [-180, -85.0511, 180, 85.0511]
      }
    }, 
    "3d-style_dm": {
      "style": "style_3d_dm.json",
      "tilejson": {
            "type": "overlay",
            "bounds": [-180, -85.0511, 180, 85.0511]
      }
    },
    "bdf-style_dm": {
      "style": "style_bdf_dm.json",
      "tilejson": {
            "type": "overlay",
            "bounds": [-180, -85.0511, 180, 85.0511]
      }
    }         
  },
  
  "data": {
    "basemaps": {
      "pmtiles": "basemaps.pmtiles"
    },    
    "administrative": {
      "pmtiles": "administrative.pmtiles"
    },
      "city_district_zone": {
      "pmtiles": "city_district_zone.pmtiles"
    },
    "address_layer": {
      "pmtiles": "address_layer.pmtiles"
    },
    "street_centerline": {
      "pmtiles": "street_centerline.pmtiles"
    },
    "main_street": {
      "pmtiles": "main_street.pmtiles"
    },
    "building_floors": {
      "pmtiles": "building_floors.pmtiles"
    },
    "building_footprint": {
      "pmtiles": "building_footprint.pmtiles"
    },
    "spl_va": {
      "pmtiles": "spl_vertical_address.pmtiles"
    },
    "pois": {
      "pmtiles": "pois_spl.pmtiles"
    }
  }  
}